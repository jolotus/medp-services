---
import settings from '../data/settings.json';
interface Props {
  title: string;
  description: string;
  image?: string;
  price?: string;
  badge?: string;
  href: string;
  whatsappText?: string;
}
const { title, description, image, price, badge, href, whatsappText } = Astro.props;
const phone = settings.contact.whatsappNumber.replace(/\D/g, '');
const whatsappUrl = whatsappText ? `https://wa.me/${phone}?text=${encodeURIComponent(whatsappText)}` : undefined;
---
<article class="group relative bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 border border-gray-100">
  {image && (
    <div class="relative h-48 overflow-hidden">
      <img src={image} alt="" width="640" height="360" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-t from-mps-navy/80 to-transparent"></div>
      {badge && <span class="absolute top-3 left-3 bg-mps-red text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">{badge}</span>}
    </div>
  )}
  <div class="p-6">
    <h3 class="font-display text-xl font-bold text-mps-navy mb-2 group-hover:text-mps-red transition-colors"><a href={href}>{title}</a></h3>
    <p class="text-gray-600 text-sm leading-relaxed mb-4">{description}</p>
    <div class="flex items-center justify-between gap-3">
      {price && <span class="text-mps-gold font-bold text-sm">{price}</span>}
      <a href={href} class="ml-auto text-sm font-medium text-mps-navy hover:text-mps-red underline decoration-2 underline-offset-4">En savoir plus</a>
    </div>
    {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex mt-4 text-xs text-[#128C7E] font-semibold hover:underline">Demander par WhatsApp</a>}
  </div>
</article>
