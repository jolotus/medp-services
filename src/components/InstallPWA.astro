<aside id="pwa-install" class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-50 max-w-sm w-[calc(100%-2rem)] bg-white rounded-2xl shadow-2xl p-4 border" role="dialog" aria-label="Installer MEDP Services">
  <div class="flex items-center gap-3"><img src="/assets/icon-72x72.png" width="40" height="40" alt="" class="rounded-lg" /><div class="flex-1"><p class="text-sm font-bold">Installer MEDP Services</p><p class="text-xs text-gray-500">Accès rapide et hors connexion.</p></div><button id="pwa-dismiss" class="text-xs text-gray-500">Fermer</button><button id="pwa-confirm" class="text-xs font-bold bg-mps-navy text-white px-3 py-2 rounded-lg">Installer</button></div>
</aside>
<script>
  let installPrompt: (Event & { prompt:()=>Promise<void>; userChoice:Promise<{outcome:string}> }) | null = null;
  const box=document.querySelector<HTMLElement>('#pwa-install');
  window.addEventListener('beforeinstallprompt', event => { event.preventDefault(); if(localStorage.getItem('medp-install-dismissed'))return; installPrompt=event as typeof installPrompt; window.setTimeout(()=>box?.classList.remove('hidden'),4000); });
  document.querySelector('#pwa-dismiss')?.addEventListener('click',()=>{box?.classList.add('hidden');localStorage.setItem('medp-install-dismissed','1');});
  document.querySelector('#pwa-confirm')?.addEventListener('click',async()=>{if(!installPrompt)return;await installPrompt.prompt();box?.classList.add('hidden');installPrompt=null;});
  window.addEventListener('appinstalled',()=>box?.classList.add('hidden'));
</script>
