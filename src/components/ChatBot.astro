---
interface Props { prices?: Record<string,string>; whatsappDisplay?: string; hours?: string; knowledge?: Array<{keywords:string[];answer:string}>; }
const { prices = {}, whatsappDisplay = '+33 7 59 08 35 80', hours = '', knowledge = [] } = Astro.props;
const responses: Record<string,string> = {
  'titre de séjour': `Notre Pack Titre de Séjour est proposé à ${prices['pack-titre-sejour'] || '900€ à 1600€'}.`,
  naturalisation: `Notre Pack Naturalisation est proposé à ${prices['pack-naturalisation'] || '1500€'}.`,
  caf: `Notre Pack CAF & APL est proposé à ${prices['pack-caf-apl'] || '80€/trimestre'}.`,
  apl: `Notre Pack CAF & APL est proposé à ${prices['pack-caf-apl'] || '80€/trimestre'}.`,
  prix: `Consultez les packs affichés sur l’accueil. Titre de séjour : ${prices['pack-titre-sejour']}; naturalisation : ${prices['pack-naturalisation']}; CAF/APL : ${prices['pack-caf-apl']}.`,
  tarif: 'Les tarifs affichés sur le site sont synchronisés avec notre catalogue.',
  whatsapp: `Contactez-nous sur WhatsApp au ${whatsappDisplay}.`,
  horaires: `Nos horaires : ${hours}.`,
  simulateur: 'Le Simulateur Intelligent vous oriente vers la prestation adaptée en quelques questions.'
};
const payload = { responses, knowledge, whatsappDisplay };
---
<div id="chatbot" class="fixed bottom-24 right-6 z-50">
  <button id="chat-open" class="w-14 h-14 rounded-full bg-mps-navy text-white shadow-2xl grid place-items-center" aria-label="Ouvrir l’assistant MEDP" aria-expanded="false"><svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg></button>
  <section id="chat-panel" class="hidden w-[min(24rem,calc(100vw-2rem))] bg-white rounded-2xl shadow-2xl border overflow-hidden" aria-label="Assistant MEDP">
    <header class="bg-mps-navy text-white p-4 flex justify-between"><div><h2 class="font-bold">Assistant MEDP</h2><p class="text-xs text-white/60">Réponses indicatives</p></div><button id="chat-close" aria-label="Fermer le chat" class="text-2xl">×</button></header>
    <div id="chat-messages" class="h-72 overflow-y-auto p-4 space-y-3" aria-live="polite"><p class="max-w-[85%] rounded-2xl bg-gray-100 p-3 text-sm">Bonjour ! Posez votre question sur nos services, tarifs ou démarches.</p></div>
    <form id="chat-form" class="p-3 border-t flex gap-2"><label class="sr-only" for="chat-input">Votre question</label><input id="chat-input" maxlength="300" autocomplete="off" class="min-w-0 flex-1 px-4 py-2.5 rounded-xl border" placeholder="Votre question…" /><button class="px-4 rounded-xl bg-mps-navy text-white" aria-label="Envoyer">➤</button></form>
  </section>
  <script type="application/json" id="chat-data" set:html={JSON.stringify(payload).replace(/</g,'\\u003c')} />
</div>
<script>
  const data = JSON.parse(document.querySelector('#chat-data')?.textContent || '{}') as { responses: Record<string,string>; knowledge: Array<{ keywords:string[]; answer:string }>; whatsappDisplay:string };
  const open = document.querySelector<HTMLButtonElement>('#chat-open'), panel=document.querySelector<HTMLElement>('#chat-panel'), input=document.querySelector<HTMLInputElement>('#chat-input'), messages=document.querySelector<HTMLElement>('#chat-messages');
  const toggle = (show:boolean) => { panel?.classList.toggle('hidden',!show); open?.classList.toggle('hidden',show); open?.setAttribute('aria-expanded',String(show)); if(show) input?.focus(); };
  open?.addEventListener('click',()=>toggle(true)); document.querySelector('#chat-close')?.addEventListener('click',()=>toggle(false));
  document.querySelector('#chat-form')?.addEventListener('submit', event => { event.preventDefault(); const value=input?.value.trim(); if(!value||!messages)return; const user=document.createElement('p'); user.className='ml-auto max-w-[85%] rounded-2xl bg-mps-navy text-white p-3 text-sm'; user.textContent=value; messages.append(user); const lower=value.toLowerCase(); const custom=data.knowledge?.find(item=>item.keywords.some(keyword=>lower.includes(keyword.toLowerCase()))); const found=custom?.answer || Object.entries(data.responses||{}).find(([key])=>lower.includes(key))?.[1] || `Je n’ai pas de réponse précise. Contactez-nous sur WhatsApp au ${data.whatsappDisplay}.`; const answer=document.createElement('p'); answer.className='max-w-[85%] rounded-2xl bg-gray-100 p-3 text-sm'; answer.textContent=found; messages.append(answer); if(input)input.value=''; messages.scrollTop=messages.scrollHeight; });
</script>
