---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import settings from '../data/settings.json';
const whatsapp = settings.contact.whatsappNumber.replace(/\D/g, '');
---

<Layout title="Générateur de Lettres — MEDP Services" description="Générez des lettres administratives personnalisées en quelques clics. Relances, recours, demandes, contestations. Export PDF gratuit.">
  <Header />

  <section class="pt-32 pb-20 bg-mps-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Générateur de Lettres</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">Rédigez en 2 minutes des lettres administratives professionnelles. Remplissez les champs, prévisualisez, téléchargez en PDF.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Form -->
        <div class="space-y-8">
          <div>
            <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">1. Choisissez votre modèle</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="template-selector">
              <button onclick="selectTemplate('relance-prefecture')" class="template-btn p-5 rounded-xl border-2 border-gray-100 hover:border-mps-navy hover:bg-mps-navy/5 transition-all text-left group active" data-template="relance-prefecture">
                <div class="text-2xl mb-2">📨</div>
                <h3 class="font-bold text-mps-navy text-sm">Relance préfecture</h3>
                <p class="text-xs text-gray-400 mt-1">Titre de séjour en retard</p>
              </button>
              <button onclick="selectTemplate('recours')" class="template-btn p-5 rounded-xl border-2 border-gray-100 hover:border-mps-red hover:bg-mps-red/5 transition-all text-left group" data-template="recours">
                <div class="text-2xl mb-2">⚖️</div>
                <h3 class="font-bold text-mps-navy text-sm">Recours gracieux</h3>
                <p class="text-xs text-gray-400 mt-1">Contester une décision</p>
              </button>
              <button onclick="selectTemplate('demande')" class="template-btn p-5 rounded-xl border-2 border-gray-100 hover:border-mps-gold hover:bg-mps-gold/5 transition-all text-left group" data-template="demande">
                <div class="text-2xl mb-2">📝</div>
                <h3 class="font-bold text-mps-navy text-sm">Demande générale</h3>
                <p class="text-xs text-gray-400 mt-1">Formalité administrative</p>
              </button>
              <button onclick="selectTemplate('caf')" class="template-btn p-5 rounded-xl border-2 border-gray-100 hover:border-green-600 hover:bg-green-50 transition-all text-left group" data-template="caf">
                <div class="text-2xl mb-2">🏠</div>
                <h3 class="font-bold text-mps-navy text-sm">Relance CAF</h3>
                <p class="text-xs text-gray-400 mt-1">Retard prestations</p>
              </button>
            </div>
          </div>

          <div>
            <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">2. Remplissez vos informations</h2>
            <div class="space-y-5" id="letter-form">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="field-nom" class="block text-sm font-medium text-gray-700 mb-1">Votre nom complet</label>
                  <input type="text" id="field-nom" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="Jean Dupont" oninput="updatePreview()" />
                </div>
                <div>
                  <label for="field-adresse" class="block text-sm font-medium text-gray-700 mb-1">Votre adresse</label>
                  <input type="text" id="field-adresse" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="12 rue de Paris, 75001 Paris" oninput="updatePreview()" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="field-destinataire" class="block text-sm font-medium text-gray-700 mb-1">Destinataire</label>
                  <input type="text" id="field-destinataire" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="Préfecture de Paris" oninput="updatePreview()" />
                </div>
                <div>
                  <label for="field-dest-adresse" class="block text-sm font-medium text-gray-700 mb-1">Adresse destinataire</label>
                  <input type="text" id="field-dest-adresse" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="9 boulevard du Palais, 75001 Paris" oninput="updatePreview()" />
                </div>
              </div>
              <div>
                <label for="field-objet" class="block text-sm font-medium text-gray-700 mb-1">Objet / Référence</label>
                <input type="text" id="field-objet" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="Relance demande titre de séjour n°2026-001234" oninput="updatePreview()" />
              </div>
              <div>
                <label for="field-details" class="block text-sm font-medium text-gray-700 mb-1">Détails supplémentaires</label>
                <textarea id="field-details" rows="3" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all resize-none" placeholder="Date de dépôt du dossier, numéro de référence, situation particulière..." oninput="updatePreview()"></textarea>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <button onclick="downloadPDF()" class="flex-1 px-8 py-4 rounded-xl bg-mps-navy text-white font-bold hover:bg-mps-navy-dark transition-all flex items-center justify-center gap-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Télécharger en PDF
            </button>
            <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent("Bonjour MEDP, j’ai généré une lettre sur le site et je souhaite un accompagnement pour l’envoyer.")}`} target="_blank" rel="noopener" class="flex-1 px-8 py-4 rounded-xl bg-[#25D366] text-white font-bold hover:bg-[#128C7E] transition-all flex items-center justify-center gap-3">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Envoyer par WhatsApp
            </a>
          </div>

          <div class="bg-mps-cream rounded-2xl p-6 border border-mps-gold/20">
            <h3 class="font-bold text-mps-navy mb-2 flex items-center gap-2">
              <svg class="w-5 h-5 text-mps-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Conseil MEDP
            </h3>
            <p class="text-sm text-gray-600">Ces modèles sont gratuits et à titre indicatif. Pour une lettre parfaitement adaptée à votre situation et des conseils sur l'envoi, nos écrivains publics vous accompagnent à partir de 15€. Contactez-nous par WhatsApp.</p>
          </div>
        </div>

        <!-- Preview -->
        <div class="lg:sticky lg:top-28">
          <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">Prévisualisation</h2>
          <div class="bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden">
            <div class="bg-gray-50 px-6 py-3 border-b border-gray-200 flex items-center justify-between">
              <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Aperçu PDF</span>
              <span class="text-xs text-gray-400">MEDP Services</span>
            </div>
            <div class="p-8 sm:p-10 font-serif text-sm leading-relaxed" id="letter-preview" style="min-height: 600px;">
              <!-- Filled by JS -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />

  <script is:inline>
    const TEMPLATES = {
      'relance-prefecture': {
        title: 'Relance préfecture — Titre de séjour',
        body: (d) => `[Ville], le ${new Date().toLocaleDateString('fr-FR')}


${d.destinataire || 'Madame, Monsieur le Directeur'}
${d.destAdresse || '[Adresse de la préfecture]'}


Objet : ${d.objet || 'Relance de ma demande de titre de séjour'}


Madame, Monsieur,

Par la présente, je me permets de vous relancer concernant ma demande de titre de séjour déposée le ${d.details || '[date de dépôt]'}. À ce jour, je n'ai toujours pas reçu de réponse ou de convocation concernant l'état d'avancement de mon dossier.

Je vous rappelle que mon titre de séjour actuel arrive à expiration prochainement, et que cette situation me cause un préjudice important dans ma vie professionnelle et personnelle. Je suis dans l'impossibilité de renouveler certains documents administratifs et de faire valoir mes droits tant que je n'ai pas de réponse définitive.

Je vous serais très reconnaissant(e) de bien vouloir accélérer l'instruction de mon dossier, ou de me tenir informé(e) de son état d'avancement. Je reste évidemment à votre entière disposition pour fournir tout document complémentaire qui serait nécessaire à l'instruction de ma demande.

Dans l'attente de votre réponse, je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.


${d.nom || '[Votre nom et prénom]'}
${d.adresse || '[Votre adresse complète]'}
Téléphone : [Votre numéro]
Email : [Votre email]`
      },
      'recours': {
        title: 'Recours gracieux',
        body: (d) => `[Ville], le ${new Date().toLocaleDateString('fr-FR')}


${d.destinataire || 'Madame, Monsieur le Directeur'}
${d.destAdresse || '[Adresse de l\'administration]'}


Objet : ${d.objet || 'Recours gracieux contre la décision du [date]'}


Madame, Monsieur,

Par la présente, je souhaite formuler un recours gracieux contre la décision de refus de [préciser la décision] notifiée le [date de notification].

En effet, cette décision me paraît entachée d'erreur / disproportionnée / contraire à mes droits pour les motifs suivants :

${d.details || '[Détailler ici les arguments de votre recours : erreur matérielle, nouveaux éléments, situation particulière, etc.]'}

Je vous demande donc de bien vouloir reconsidérer cette décision et me la notifier à nouveau dans un sens favorable. Je joins à ce recours les pièces justificatives complémentaires suivantes :
- [Liste des pièces jointes]

Je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.


${d.nom || '[Votre nom et prénom]'}
${d.adresse || '[Votre adresse complète]'}`
      },
      'demande': {
        title: 'Demande administrative générale',
        body: (d) => `[Ville], le ${new Date().toLocaleDateString('fr-FR')}


${d.destinataire || 'Madame, Monsieur'}
${d.destAdresse || '[Adresse du destinataire]'}


Objet : ${d.objet || 'Demande de [préciser la demande]'}


Madame, Monsieur,

Par la présente, je vous demande de bien vouloir [préciser la demande exacte].

${d.details || '[Détailler ici les motivations, les éléments contextuels, et les informations nécessaires à la compréhension de votre demande.]'}

Je vous prie de trouver ci-joint les pièces justificatives suivantes :
- [Liste des pièces jointes]

Je vous remercie de l'attention que vous porterez à ma demande et reste à votre entière disposition pour tout renseignement complémentaire.

Dans l'attente de votre réponse, je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.


${d.nom || '[Votre nom et prénom]'}
${d.adresse || '[Votre adresse complète]'}`
      },
      'caf': {
        title: 'Relance CAF — Retard prestations',
        body: (d) => `[Ville], le ${new Date().toLocaleDateString('fr-FR')}


${d.destinataire || 'Madame, Monsieur le Directeur de la CAF'}
${d.destAdresse || '[Adresse de votre CAF]'}


Objet : ${d.objet || 'Relance concernant le retard de versement de mes prestations'}


Madame, Monsieur,

Par la présente, je me permets de vous relancer concernant le retard de versement de mes prestations familiales. En effet, mon dernier paiement date du [date], et je n'ai depuis lors perçu aucune allocation, alors que ma situation n'a pas changé.

Cette interruption de paiement me cause un préjudice financier important et met en péril ma situation personnelle et familiale. Je vous rappelle que j'ai effectué ma dernière déclaration de situation trimestrielle le [date], et que tous les éléments de mon dossier sont à jour.

Je vous demande donc de bien vouloir procéder au versement des sommes dues dans les meilleurs délais, et de m'informer de l'état de mon dossier.

Je reste à votre disposition pour tout renseignement complémentaire et vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.


${d.nom || '[Votre nom et prénom]'}
${d.adresse || '[Votre adresse complète]'}
Numéro d'allocataire : [Votre numéro]`
      }
    };

    let currentTemplate = 'relance-prefecture';
    const escapeHtml = (value) => String(value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');

    function selectTemplate(template) {
      currentTemplate = template;
      document.querySelectorAll('.template-btn').forEach(btn => {
        btn.classList.remove('active', 'border-mps-navy', 'bg-mps-navy/5', 'border-mps-red', 'bg-mps-red/5', 'border-mps-gold', 'bg-mps-gold/5', 'border-green-600', 'bg-green-50');
        btn.classList.add('border-gray-100');
      });
      const activeBtn = document.querySelector(`[data-template="${template}"]`);
      if (activeBtn) {
        activeBtn.classList.remove('border-gray-100');
        const colors = {
          'relance-prefecture': ['border-mps-navy', 'bg-mps-navy/5'],
          'recours': ['border-mps-red', 'bg-mps-red/5'],
          'demande': ['border-mps-gold', 'bg-mps-gold/5'],
          'caf': ['border-green-600', 'bg-green-50']
        };
        activeBtn.classList.add(...colors[template]);
      }
      updatePreview();
    }

    function getFormData() {
      return {
        nom: document.getElementById('field-nom').value,
        adresse: document.getElementById('field-adresse').value,
        destinataire: document.getElementById('field-destinataire').value,
        destAdresse: document.getElementById('field-dest-adresse').value,
        objet: document.getElementById('field-objet').value,
        details: document.getElementById('field-details').value,
      };
    }

    function updatePreview() {
      const data = getFormData();
      const template = TEMPLATES[currentTemplate];
      const body = template.body(data);
      
      const preview = document.getElementById('letter-preview');
      preview.replaceChildren();
      const text = document.createElement('div');
      text.className = 'whitespace-pre-wrap font-serif text-gray-800 leading-relaxed';
      text.textContent = body;
      const footer = document.createElement('div');
      footer.className = 'mt-8 pt-4 border-t border-gray-100 text-xs text-gray-400';
      footer.textContent = 'Lettre générée localement par MEDP Services — aucune donnée saisie n’est envoyée au serveur.';
      preview.append(text, footer);
    }

    function downloadPDF() {
      const data = getFormData();
      const template = TEMPLATES[currentTemplate];
      const body = template.body(data);
      
      // Simple print to PDF using window.print
      const printWindow = window.open('', '_blank');
      if (!printWindow) { alert('Autorisez les fenêtres contextuelles pour exporter la lettre.'); return; }
      const safeBody = escapeHtml(body);
      const safeTitle = escapeHtml(template.title);
      const safeName = escapeHtml(data.nom || 'Lettre MEDP');
      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <title>${safeTitle} - ${safeName}</title>
          <style>
            @page { margin: 2cm; }
            body { font-family: 'Times New Roman', serif; font-size: 12pt; line-height: 1.6; color: #000; max-width: 800px; margin: 0 auto; padding: 40px; }
            .header { text-align: center; margin-bottom: 30px; }
            .header img { height: 50px; }
            .footer { margin-top: 40px; font-size: 9pt; color: #666; border-top: 1px solid #ddd; padding-top: 10px; text-align: center; }
          </style>
        </head>
        <body>
          <div class="header">
            <img src="https://medp-services.netlify.app/assets/logo-mps-3d.webp" alt="MEDP Services" />
          </div>
          <pre style="white-space: pre-wrap; font-family: inherit; font-size: inherit; line-height: inherit;">${safeBody}</pre>
          <div class="footer">
            Lettre générée par MEDP Services — medp-services.netlify.app<br>
            Accompagnement administratif & services à la personne
          </div>
          <scr${'ipt'}>window.print(); setTimeout(() => window.close(), 500);</scr${'ipt'}>
        </body>
        </html>
      `);
      printWindow.document.close();
    }

    // Init
    selectTemplate('relance-prefecture');
  </script>
</Layout>
