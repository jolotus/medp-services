---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout noindex title="Page introuvable — MEDP Services" description="La page demandée n’existe pas ou a été déplacée.">
  <Header />
  <main class="min-h-[70vh] pt-36 pb-20 bg-mps-cream grid place-items-center" id="main-content">
    <div class="max-w-xl px-4 text-center">
      <p class="font-black text-7xl text-mps-gold mb-4" aria-hidden="true">404</p>
      <h1 class="font-display text-4xl font-bold text-mps-navy mb-4">Cette page est introuvable</h1>
      <p class="text-gray-600 mb-8">Le lien est peut-être ancien ou incorrect. Retrouvez les prestations depuis la page d’accueil.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="/" class="px-6 py-3 rounded-full bg-mps-navy text-white font-bold">Accueil</a><a href="/services" class="px-6 py-3 rounded-full border border-mps-navy text-mps-navy font-bold">Services</a></div>
    </div>
  </main>
  <Footer />
</Layout>
