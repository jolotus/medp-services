---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const tariffs = await getCollection('tarifs');
const tariffBySlug = new Map(tariffs.map(t => [t.slug, t.data]));
const servicePrice = (service: CollectionEntry<'services'>) => service.data.tariffSlug ? (tariffBySlug.get(service.data.tariffSlug)?.price || service.data.price) : service.data.price;

const services = await getCollection('services').then(a => a.sort((a,b) => a.data.order - b.data.order));
const categories = [...new Set(services.map(s => s.data.category))];

const catLabels = {
  accueil: 'Accueil & Orientation',
  etrangers: 'Étrangers & Séjour',
  social: 'Social & Administratif',
  documents: 'Documents & Écriture',
  famille: 'Famille & Allocations',
  personne: 'Services à la Personne'
};
---

<Layout title="Nos Services — MEDP Services" description="Découvrez tous nos services : accompagnement étrangers, services à la personne, écrivain public, aide administrative.">
  <Header />

  <section class="pt-32 pb-20 bg-mps-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Nos services</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">6 pôles d'expertise pour vous accompagner au quotidien dans toutes vos démarches administratives et personnelles.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {categories.map(cat => {
        const catServices = services.filter(s => s.data.category === cat);
        return (
          <div class="mb-16">
            <h2 class="font-display text-2xl font-bold text-mps-navy mb-6 flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-mps-navy/10 flex items-center justify-center text-mps-red text-xl">{catServices[0]?.data.icon}</span>
              {catLabels[cat] || cat}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {catServices.map(s => (
                <ServiceCard
                  title={s.data.title}
                  description={s.data.description}
                  image={s.data.image}
                  price={servicePrice(s)}
                  badge={s.data.badge}
                  href={`/services/${s.slug}`}
                  whatsappText={s.data.whatsappText}

                />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <Footer />
  <WhatsAppButton />
</Layout>
