---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import WhatsAppButton from '../components/WhatsAppButton';
---

<Layout title="Merci pour votre confiance — MEDP Services" description="Votre paiement ou demande a été enregistrée. Nous vous recontactons très rapidement.">
  <Header client:load />

  <section class="pt-32 pb-20 min-h-[70vh] flex items-center justify-center bg-mps-cream">
    <div class="max-w-xl mx-auto px-4 text-center">
      <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-green-100 flex items-center justify-center">
        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-bold text-mps-navy mb-4">Merci pour votre confiance !</h1>
      <p class="text-gray-600 text-lg mb-8">Votre demande a bien été enregistrée. Notre équipe MEDP vous recontacte sous 24h maximum par WhatsApp ou téléphone.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="px-6 py-3 rounded-full bg-mps-navy text-white font-semibold hover:bg-blue-900 transition-colors">Retour à l'accueil</a>
        <WhatsAppButton text="Bonjour MEDP, je viens de finaliser ma commande. Quelles sont les prochaines étapes ?" floating={false} client:load />
      </div>
    </div>
  </section>

  <Footer client:load />
</Layout>
