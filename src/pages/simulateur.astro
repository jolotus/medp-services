---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import settings from '../data/settings.json';
import { getCollection } from 'astro:content';

const tariffs = await getCollection('tarifs');
const services = await getCollection('services');
const simulatorPricing = {
  tariffs: Object.fromEntries(tariffs.map(t => [t.slug, { title: t.data.title, price: t.data.price, description: t.data.description, includes: t.data.includes }])),
  services: Object.fromEntries(services.map(service => [service.slug, { price: service.data.price }])),
  whatsappNumber: (settings.contact?.whatsappNumber || '+33759083580').replace(/\D/g, '')
};
---

<Layout title="Simulateur Intelligent — MEDP Services" description="Découvrez rapidement quelle démarche vous correspond : titre de séjour, naturalisation, CAF, APL, et plus. Diagnostic personnalisé en 2 minutes.">
  <Header />

  <section class="pt-32 pb-20 bg-mps-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Simulateur Intelligent</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">En quelques questions, découvrez exactement quelle démarche vous correspond et quel pack MEDP vous faire accompagner.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Step 1: Situation -->
      <div id="sim-step-1" class="space-y-8">
        <div class="text-center mb-10">
          <span class="inline-block px-4 py-1 rounded-full bg-mps-navy/5 text-mps-navy text-xs font-bold uppercase tracking-wider mb-4">Étape 1 / 3</span>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-mps-navy mb-2">Quelle est votre situation ?</h2>
          <p class="text-gray-500">Sélectionnez la catégorie qui vous correspond le mieux.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <button onclick="selectSituation('etranger')" class="group relative p-8 rounded-2xl border-2 border-gray-100 hover:border-mps-navy hover:bg-mps-navy/5 transition-all duration-300 text-left">
            <div class="w-14 h-14 rounded-xl bg-mps-navy/10 flex items-center justify-center text-3xl mb-4 group-hover:bg-mps-navy group-hover:text-white transition-colors">🌍</div>
            <h3 class="font-display font-bold text-lg text-mps-navy mb-2">Étranger en France</h3>
            <p class="text-sm text-gray-500">Je souhaite obtenir ou renouveler un titre de séjour, me naturaliser, ou faire venir ma famille.</p>
          </button>

          <button onclick="selectSituation('famille')" class="group relative p-8 rounded-2xl border-2 border-gray-100 hover:border-mps-red hover:bg-mps-red/5 transition-all duration-300 text-left">
            <div class="w-14 h-14 rounded-xl bg-mps-red/10 flex items-center justify-center text-3xl mb-4 group-hover:bg-mps-red group-hover:text-white transition-colors">👨‍👩‍👧‍👦</div>
            <h3 class="font-display font-bold text-lg text-mps-navy mb-2">Famille & Allocations</h3>
            <p class="text-sm text-gray-500">J'ai besoin d'aide pour la CAF, l'APL, la prime d'activité, ou le regroupement familial.</p>
          </button>

          <button onclick="selectSituation('documents')" class="group relative p-8 rounded-2xl border-2 border-gray-100 hover:border-mps-gold hover:bg-mps-gold/5 transition-all duration-300 text-left">
            <div class="w-14 h-14 rounded-xl bg-mps-gold/10 flex items-center justify-center text-3xl mb-4 group-hover:bg-mps-gold group-hover:text-white transition-colors">📝</div>
            <h3 class="font-display font-bold text-lg text-mps-navy mb-2">Documents & Écriture</h3>
            <p class="text-sm text-gray-500">Je ne sais pas remplir un formulaire, rédiger une lettre administrative, ou constituer un dossier.</p>
          </button>

          <button onclick="selectSituation('personne')" class="group relative p-8 rounded-2xl border-2 border-gray-100 hover:border-green-600 hover:bg-green-50 transition-all duration-300 text-left">
            <div class="w-14 h-14 rounded-xl bg-green-100 flex items-center justify-center text-3xl mb-4 group-hover:bg-green-600 group-hover:text-white transition-colors">🏠</div>
            <h3 class="font-display font-bold text-lg text-mps-navy mb-2">Services à domicile</h3>
            <p class="text-sm text-gray-500">J'ai besoin d'aide à domicile (ménage, repassage, courses) ou je souhaite proposer mes services.</p>
          </button>
        </div>
      </div>

      <!-- Step 2: Sub-questions (dynamic) -->
      <div id="sim-step-2" class="hidden space-y-8">
        <div class="text-center mb-10">
          <span class="inline-block px-4 py-1 rounded-full bg-mps-navy/5 text-mps-navy text-xs font-bold uppercase tracking-wider mb-4">Étape 2 / 3</span>
          <h2 id="step-2-title" class="font-display text-2xl sm:text-3xl font-bold text-mps-navy mb-2">Précisez votre situation</h2>
          <p class="text-gray-500">Cela nous permet de vous orienter vers le bon accompagnement.</p>
        </div>

        <div id="step-2-etranger" class="hidden space-y-4">
          <button onclick="selectSub('titre-sejour')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-navy hover:bg-mps-navy/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">🛂</span>
            <div><h4 class="font-bold text-mps-navy">Titre de séjour</h4><p class="text-sm text-gray-500">Première demande ou renouvellement</p></div>
          </button>
          <button onclick="selectSub('naturalisation')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-navy hover:bg-mps-navy/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">🇫🇷</span>
            <div><h4 class="font-bold text-mps-navy">Naturalisation</h4><p class="text-sm text-gray-500">Devenir Français par décret</p></div>
          </button>
          <button onclick="selectSub('regroupement')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-navy hover:bg-mps-navy/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">👨‍👩‍👧‍👦</span>
            <div><h4 class="font-bold text-mps-navy">Regroupement familial</h4><p class="text-sm text-gray-500">Faire venir ma famille en France</p></div>
          </button>
          <button onclick="selectSub('visa-cameroun')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-navy hover:bg-mps-navy/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">🇨🇲</span>
            <div><h4 class="font-bold text-mps-navy">Visa / Passeport Camerounais</h4><p class="text-sm text-gray-500">Démarches consulaires</p></div>
          </button>
        </div>

        <div id="step-2-famille" class="hidden space-y-4">
          <button onclick="selectSub('caf-apl')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-red hover:bg-mps-red/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">🏠</span>
            <div><h4 class="font-bold text-mps-navy">CAF / APL / ALS</h4><p class="text-sm text-gray-500">Aide au logement et prestations familiales</p></div>
          </button>
          <button onclick="selectSub('prime-activite')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-red hover:bg-mps-red/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">💶</span>
            <div><h4 class="font-bold text-mps-navy">Prime d'activité</h4><p class="text-sm text-gray-500">Complément de revenus d'activité</p></div>
          </button>
          <button onclick="selectSub('france-travail')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-red hover:bg-mps-red/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">💼</span>
            <div><h4 class="font-bold text-mps-navy">France Travail (Pôle emploi)</h4><p class="text-sm text-gray-500">Actualisation et déclarations</p></div>
          </button>
        </div>

        <div id="step-2-documents" class="hidden space-y-4">
          <button onclick="selectSub('lettre')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-gold hover:bg-mps-gold/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">✉️</span>
            <div><h4 class="font-bold text-mps-navy">Rédaction de lettre</h4><p class="text-sm text-gray-500">Recours, relance, demande, contestation</p></div>
          </button>
          <button onclick="selectSub('formulaire')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-gold hover:bg-mps-gold/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">📋</span>
            <div><h4 class="font-bold text-mps-navy">Remplissage de formulaire</h4><p class="text-sm text-gray-500">ANEF, CAF, impôts, France Travail...</p></div>
          </button>
          <button onclick="selectSub('dossier')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-mps-gold hover:bg-mps-gold/5 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">📁</span>
            <div><h4 class="font-bold text-mps-navy">Constitution de dossier</h4><p class="text-sm text-gray-500">Tri, classement, vérification des pièces</p></div>
          </button>
        </div>

        <div id="step-2-personne" class="hidden space-y-4">
          <button onclick="selectSub('menage')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-green-600 hover:bg-green-50 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">🧹</span>
            <div><h4 class="font-bold text-mps-navy">Ménage</h4><p class="text-sm text-gray-500">Nettoyage complet, sols, vitres, cuisine</p></div>
          </button>
          <button onclick="selectSub('repassage')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-green-600 hover:bg-green-50 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">👔</span>
            <div><h4 class="font-bold text-mps-navy">Repassage</h4><p class="text-sm text-gray-500">À domicile ou en récupération</p></div>
          </button>
          <button onclick="selectSub('courses')" class="w-full p-6 rounded-2xl border border-gray-100 hover:border-green-600 hover:bg-green-50 transition-all text-left flex items-center gap-4">
            <span class="text-2xl">🛒</span>
            <div><h4 class="font-bold text-mps-navy">Courses & accompagnement</h4><p class="text-sm text-gray-500">Courses, pharmacie, promenade</p></div>
          </button>
        </div>

        <button onclick="backToStep1()" class="text-sm text-gray-400 hover:text-mps-navy flex items-center gap-2 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M15 19l-7-7 7-7"/></svg>
          Retour
        </button>
      </div>

      <!-- Step 3: Result -->
      <div id="sim-step-3" class="hidden space-y-8">
        <div class="text-center mb-10">
          <span class="inline-block px-4 py-1 rounded-full bg-mps-gold/10 text-mps-gold text-xs font-bold uppercase tracking-wider mb-4">Résultat</span>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-mps-navy mb-2">Votre diagnostic personnalisé</h2>
          <p class="text-gray-500">Voici le pack MEDP recommandé pour votre situation.</p>
        </div>

        <div id="result-card" class="bg-gradient-to-br from-mps-navy to-mps-navy-dark rounded-3xl p-8 sm:p-12 text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-mps-gold/10 rounded-full blur-3xl pointer-events-none" />
          <div id="result-content" class="relative z-10">
            <!-- Filled by JS -->
          </div>
        </div>

        <div class="text-center">
          <button onclick="backToStep1()" class="text-sm text-gray-400 hover:text-mps-navy flex items-center gap-2 mx-auto transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Refaire le simulateur
          </button>
        </div>
      </div>

    </div>
  </section>

  <Footer />
  <WhatsAppButton />

  <script type="application/json" id="simulator-pricing" set:html={JSON.stringify(simulatorPricing).replace(/</g, '\\u003c')} />
  <script is:inline>
    const RESULTS = {
      'titre-sejour': {
        title: 'Pack Titre de Séjour',
        price: '900€ à 1600€',
        desc: 'Accompagnement complet pour votre demande ou renouvellement de titre de séjour via l\'ANEF.',
        includes: ['Analyse de votre situation et éligibilité', 'Constitution complète du dossier ANEF', 'Vérification des pièces justificatives', 'Rédaction des lettres de relance', 'Suivi jusqu\'à la réception du titre', 'Accès prioritaire WhatsApp pendant 3 mois'],
        cta: 'Commander le Pack Titre de Séjour',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a recommandé le Pack Titre de Séjour. Je souhaite en savoir plus.',
        link: '/services/etrangers-sejour'
      },
      'naturalisation': {
        title: 'Pack Naturalisation',
        price: '1500€',
        desc: 'Accompagnement de A à Z pour votre demande de naturalisation française.',
        includes: ['Évaluation de l\'éligibilité', 'Constitution du dossier', 'Préparation à l\'entretien d\'assimilation', 'Quiz interactif et fiches', 'Suivi complet jusqu\'à la décision', 'Accès prioritaire WhatsApp 6 mois'],
        cta: 'Commander le Pack Naturalisation',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a recommandé le Pack Naturalisation. Je souhaite en savoir plus.',
        link: '/services/etrangers-sejour'
      },
      'regroupement': {
        title: 'Regroupement Familial',
        price: '200€ à 2000€',
        desc: 'Le Pack Titre de Séjour couvre également le regroupement familial.',
        includes: ['Analyse du droit au regroupement', 'Constitution du dossier complet', 'Vérification des pièces du conjoint/enfants', 'Suivi préfecture', 'Accès prioritaire WhatsApp'],
        cta: 'Commander ce pack',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a recommandé le Pack Titre de Séjour pour un regroupement familial.',
        link: '/services/etrangers-sejour'
      },
      'visa-cameroun': {
        title: 'Passeport & Visa camerounais (en ligne)',
        price: '90€',
        desc: 'Nous vous accompagnons dans toutes les démarches consulaires camerounaises.',
        includes: ['Vérification de votre dossier', 'Remplissage des formulaires', 'Prise de rendez-vous', 'Suivi de votre demande', 'Conseil en cas de difficulté'],
        cta: 'Demander un devis par WhatsApp',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a orienté vers l\'accompagnement visa/passeport camerounais.',
        link: '/services/etrangers-sejour'
      },
      'caf-apl': {
        title: 'Pack CAF & APL',
        price: '80€/trimestre',
        desc: 'Accompagnement complet pour votre demande de prestations CAF et APL.',
        includes: ['Simulation d\'éligibilité', 'Remplissage formulaires CAF', 'Vérification pièces', 'Suivi jusqu\'au 1er versement', 'Conseil déclaration trimestrielle'],
        cta: 'Commander le Pack CAF & APL',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a recommandé le Pack CAF & APL.',
        link: '/services/famille-allocations'
      },
      'prime-activite': {
        title: 'Pack CAF & APL',
        price: '80€/trimestre',
        desc: 'La prime d\'activité est gérée dans le cadre du Pack CAF & APL.',
        includes: ['Simulation', 'Demande en ligne', 'Suivi', 'Conseil actualisation'],
        cta: 'Commander le Pack CAF & APL',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a recommandé le Pack CAF & APL pour la prime d\'activité.',
        link: '/services/famille-allocations'
      },
      'france-travail': {
        title: 'Pack CAF & APL',
        price: '80€/trimestre',
        desc: 'L\'actualisation France Travail est incluse dans notre Pack CAF & APL.',
        includes: ['Rappel des échéances', 'Actualisation en ligne', 'Déclaration d\'emploi', 'Conseil'],
        cta: 'Commander le Pack CAF & APL',
        whatsapp: 'Bonjour MEDP, j\'ai besoin d\'aide pour mon actualisation France Travail.',
        link: '/services/famille-allocations'
      },
      'lettre': {
        title: 'Lettre administrative',
        price: 'À partir de 15€',
        desc: 'Rédaction professionnelle de votre lettre administrative par notre écrivain public.',
        includes: ['Écoute de votre situation', 'Rédaction structurée et percutante', 'Relecture et corrections', 'Conseil sur la démarche suivante'],
        cta: 'Commander par WhatsApp',
        whatsapp: 'Bonjour MEDP, le simulateur m\'a orienté vers la rédaction d\'une lettre administrative.',
        link: '/services/documents-ecriture'
      },
      'formulaire': {
        title: 'Remplissage de formulaire',
        price: '15€ par formulaire',
        desc: 'Nous remplissons pour vous les formulaires les plus complexes.',
        includes: ['Vérification de votre éligibilité', 'Remplissage complet', 'Vérification conformité', 'Conseil pièces justificatives'],
        cta: 'Commander par WhatsApp',
        whatsapp: 'Bonjour MEDP, j\'ai besoin d\'aide pour remplir un formulaire.',
        link: '/services/documents-ecriture'
      },
      'dossier': {
        title: 'Constitution de dossier',
        price: 'Sur devis',
        desc: 'Nous organisons, vérifions et complétons votre dossier administratif.',
        includes: ['Audit du dossier existant', 'Liste des pièces manquantes', 'Rangement et classement', 'Vérification conformité'],
        cta: 'Demander un devis',
        whatsapp: 'Bonjour MEDP, j\'ai besoin d\'aide pour constituer un dossier administratif.',
        link: '/services/documents-ecriture'
      },
      'menage': {
        title: 'Ménage à domicile',
        price: '22€ à 35€/heure',
        desc: 'Intervention professionnelle chez vous avec crédit d\'impôt 50%.',
        includes: ['Nettoyage complet', 'Produits fournis sur demande', 'Intervenant de confiance', 'Crédit d\'impôt 50%'],
        cta: 'Devis gratuit par WhatsApp',
        whatsapp: 'Bonjour MEDP, je cherche une aide ménagère à domicile.',
        link: '/services/services-personne'
      },
      'repassage': {
        title: 'Repassage à domicile',
        price: '22€ à 35€/heure',
        desc: 'Vos vêtements repassés à domicile ou en récupération/livraison.',
        includes: ['Repassage soigné', 'Rangement', 'Livraison possible', 'Crédit d\'impôt 50%'],
        cta: 'Devis gratuit par WhatsApp',
        whatsapp: 'Bonjour MEDP, je cherche une aide au repassage.',
        link: '/services/services-personne'
      },
      'courses': {
        title: 'Courses & accompagnement',
        price: '22€ à 35€/heure',
        desc: 'Courses, pharmacie, promenade, accompagnement personnalisé.',
        includes: ['Courses au choix', 'Pharmacie', 'Promenade', 'Personne de confiance'],
        cta: 'Devis gratuit par WhatsApp',
        whatsapp: 'Bonjour MEDP, j\'ai besoin d\'aide pour les courses et accompagnement.',
        link: '/services/services-personne'
      },
    };

    const pricing = JSON.parse(document.getElementById('simulator-pricing')?.textContent || '{}');
    const tariffLinks = {
      'titre-sejour': 'pack-titre-sejour',
      'naturalisation': 'pack-naturalisation',
      'regroupement': 'regroupement-familial',
      'visa-cameroun': 'passeport-visa-camerounais',
      'caf-apl': 'pack-caf-apl',
      'prime-activite': 'pack-caf-apl',
      'france-travail': 'pack-caf-apl'
    };
    Object.entries(tariffLinks).forEach(([resultKey, tariffSlug]) => {
      const tariff = pricing.tariffs?.[tariffSlug];
      if (!tariff || !RESULTS[resultKey]) return;
      RESULTS[resultKey].title = tariff.title;
      RESULTS[resultKey].price = tariff.price;
      RESULTS[resultKey].desc = tariff.description;
      RESULTS[resultKey].includes = tariff.includes;
    });
    ['lettre', 'formulaire', 'dossier'].forEach(key => {
      if (RESULTS[key]) RESULTS[key].price = pricing.services?.['documents-ecriture']?.price || RESULTS[key].price;
    });
    ['menage', 'repassage', 'courses'].forEach(key => {
      if (RESULTS[key]) RESULTS[key].price = pricing.services?.['services-personne']?.price || RESULTS[key].price;
    });

    const escapeHtml = (value) => String(value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');

    let currentSituation = '';

    function selectSituation(situation) {
      currentSituation = situation;
      document.getElementById('sim-step-1').classList.add('hidden');
      document.getElementById('sim-step-2').classList.remove('hidden');
      
      // Hide all sub-panels
      ['etranger', 'famille', 'documents', 'personne'].forEach(s => {
        document.getElementById('step-2-' + s).classList.add('hidden');
      });
      // Show relevant
      document.getElementById('step-2-' + situation).classList.remove('hidden');
      
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function selectSub(sub) {
      const result = RESULTS[sub];
      if (!result) return;
      
      document.getElementById('sim-step-2').classList.add('hidden');
      document.getElementById('sim-step-3').classList.remove('hidden');
      
      const content = document.getElementById('result-content');
      content.innerHTML = `
        <div class="flex items-center gap-3 mb-6">
          <span class="px-3 py-1 rounded-full bg-mps-gold/20 text-mps-gold text-xs font-bold uppercase tracking-wider border border-mps-gold/30">Recommandé</span>
        </div>
        <h3 class="font-display text-3xl font-bold mb-2">${escapeHtml(result.title)}</h3>
        <p class="text-4xl font-black text-mps-gold mb-6">${escapeHtml(result.price)}</p>
        <p class="text-white/80 text-lg mb-8 max-w-xl">${escapeHtml(result.desc)}</p>
        <ul class="space-y-3 mb-10">
          ${result.includes.map(i => `<li class="flex items-start gap-3 text-white/90"><svg class="w-5 h-5 text-mps-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>${escapeHtml(i)}</li>`).join('')}
        </ul>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="${escapeHtml(result.link)}" class="px-8 py-4 rounded-full bg-mps-gold text-mps-navy-dark font-bold text-center hover:bg-mps-gold-light transition-all hover:scale-105 shadow-lg">
            ${escapeHtml(result.cta)}
          </a>
