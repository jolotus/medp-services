---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import WhatsAppButton from '../../components/WhatsAppButton';
import StripeCheckout from '../../components/StripeCheckout';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(s => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const { Content } = await service.render();
---

<Layout title={`${service.data.title} — MEDP Services`} description={service.data.description} image={service.data.image}>
  <Header client:load />

  <section class="pt-32 pb-12 bg-mps-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <a href="/services" class="text-white/60 hover:text-white text-sm">← Services</a>
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-bold mb-4">{service.data.title}</h1>
      <p class="text-white/80 text-lg">{service.data.description}</p>
      <div class="flex flex-wrap items-center gap-4 mt-6">
        {service.data.price && (
          <span class="px-4 py-2 rounded-full bg-mps-gold/20 text-mps-gold font-bold border border-mps-gold/30">
            {service.data.price}
          </span>
        )}
        {service.data.badge && (
          <span class="px-4 py-2 rounded-full bg-mps-red/20 text-white font-bold border border-mps-red/30">
            {service.data.badge}
          </span>
        )}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {service.data.image && (
        <img src={service.data.image} alt={service.data.title} class="w-full h-64 sm:h-96 object-cover rounded-2xl shadow-lg mb-10" loading="eager" />
      )}
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-mps-navy prose-a:text-mps-red hover:prose-a:text-mps-navy">
        <Content />
      </div>

      <div class="mt-12 p-8 bg-mps-cream rounded-2xl border border-mps-gold/20">
        <h3 class="font-display text-xl font-bold text-mps-navy mb-4">Intéressé(e) par cette prestation ?</h3>
        <div class="flex flex-col sm:flex-row gap-4">
          <WhatsAppButton text={service.data.whatsappText || `Bonjour MEDP, je suis intéressé(e) par : ${service.data.title}`} floating={false} client:load />
          <StripeCheckout buttonText="Commander en ligne" client:load />
        </div>
      </div>
    </div>
  </section>

  <Footer client:load />
  <WhatsAppButton client:load />
</Layout>
