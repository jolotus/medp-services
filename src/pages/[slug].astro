---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', page => page.data.published);
  return pages.map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await page.render();
---
<Layout title={page.data.title} description={page.data.description}>
  <Header />
  <main class="pt-32 pb-20 bg-white" id="main-content">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-mps-red mb-3">Informations</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-mps-navy mb-4">{page.data.title}</h1>
      {page.data.updatedDate && <p class="text-sm text-gray-500 mb-10">Mise à jour : {page.data.updatedDate.toLocaleDateString('fr-FR')}</p>}
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-mps-navy prose-a:text-mps-red"><Content /></div>
    </article>
  </main>
  <Footer />
</Layout>
