---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import WhatsAppButton from '../components/WhatsAppButton';
---

<Layout title="Contact — MEDP Services" description="Contactez Meudjieuh Prestation & Services par WhatsApp, téléphone ou formulaire. Réponse rapide et confidentialité garantie.">
  <Header client:load />

  <section class="pt-32 pb-12 bg-mps-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Contactez-nous</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">Disponible par WhatsApp, téléphone ou formulaire. Confidentialité et discrétion assurées à chaque échange.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">Nos coordonnées</h2>
            <div class="space-y-4">
              <a href="https://wa.me/33759083580" target="_blank" rel="noopener" class="flex items-start gap-4 p-4 rounded-xl bg-[#25D366]/5 border border-[#25D366]/10 hover:bg-[#25D366]/10 transition-colors group">
                <div class="w-12 h-12 rounded-full bg-[#25D366] flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                </div>
                <div>
                  <p class="font-bold text-mps-dark">WhatsApp Principal</p>
                  <p class="text-gray-600">+33 7 59 08 35 80</p>
                  <p class="text-xs text-gray-400 mt-1">Réponse rapide, 7j/7</p>
                </div>
              </a>

              <div class="flex items-start gap-4 p-4 rounded-xl bg-mps-navy/5 border border-mps-navy/10">
                <div class="w-12 h-12 rounded-full bg-mps-navy flex items-center justify-center text-white flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p class="font-bold text-mps-dark">Téléphone</p>
                  <p class="text-gray-600">+33 7 59 08 35 80</p>
                  <p class="text-xs text-gray-400 mt-1">Appel et WhatsApp</p>
                </div>
              </div>

              <div class="flex items-start gap-4 p-4 rounded-xl bg-mps-navy/5 border border-mps-navy/10">
                <div class="w-12 h-12 rounded-full bg-mps-navy flex items-center justify-center text-white flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <p class="font-bold text-mps-dark">Horaires d'ouverture</p>
                  <p class="text-gray-600">Lundi – Vendredi : 08h00 – 18h00</p>
                  <p class="text-gray-600">Samedi : 09h00 – 14h00</p>
                  <p class="text-xs text-gray-400 mt-1">Support WhatsApp : 7j/7</p>
                </div>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-mps-cream border border-mps-gold/20">
            <h3 class="font-display text-lg font-bold text-mps-navy mb-2">Confidentialité garantie</h3>
            <p class="text-sm text-gray-600">Toutes vos demandes sont traitées dans la plus stricte confidentialité. Nous ne partageons jamais vos informations avec des tiers sans votre consentement explicite.</p>
          </div>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">Envoyer une demande</h2>
          <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-5">
            <p class="hidden">
              <label>Ne pas remplir : <input name="bot-field" /></label>
            </p>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nom complet</label>
              <input type="text" name="name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="Votre nom et prénom" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
                <input type="tel" name="phone" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="+33 6 00 00 00 00" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input type="email" name="email" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="votre@email.com" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Service souhaité</label>
              <select name="service" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all bg-white">
                <option value="">Choisir un service...</option>
                <option value="titre-sejour">Titre de séjour / Naturalisation</option>
                <option value="caf-apl">CAF / APL / Allocations</option>
                <option value="documents">Remplissage documents / Écrivain public</option>
                <option value="services-personne">Services à la personne (ménage, repassage...)</option>
                <option value="social">Accompagnement social</option>
                <option value="autre">Autre demande</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Votre message</label>
              <textarea name="message" rows="4" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all resize-none" placeholder="Décrivez votre besoin en quelques lignes..."></textarea>
            </div>
            <button type="submit" class="w-full px-6 py-4 rounded-xl bg-mps-navy text-white font-bold text-lg hover:bg-blue-900 transition-all active:scale-95 shadow-lg flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Envoyer ma demande
            </button>
            <p class="text-xs text-gray-400 text-center">Vous recevrez une réponse sous 24h maximum.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer client:load />
  <WhatsAppButton client:load />
</Layout>
