---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import settings from '../data/settings.json';
import { getCollection } from 'astro:content';

const faqs = await getCollection('faq').then(items => items.sort((a,b) => a.data.order - b.data.order));
const services = await getCollection('services').then(items => items.sort((a,b) => a.data.order - b.data.order));
const privacyPage = await getCollection('pages').then(items => items.find(page => page.slug === 'confidentialite' && page.data.published));
const contact = settings.contact;
const whatsapp = contact.whatsappNumber.replace(/\D/g, '');
---

<Layout title="Contact — MEDP Services" description="Contactez Meudjieuh Prestation & Services par WhatsApp, téléphone ou formulaire. Réponse rapide et traitement confidentiel de votre demande.">
  <Header />

  <section class="pt-32 pb-12 bg-mps-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Contactez-nous</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">Disponible par WhatsApp, téléphone ou formulaire. Votre demande est traitée de manière confidentielle.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">Nos coordonnées</h2>
            <div class="space-y-4">
              <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener" class="flex items-start gap-4 p-4 rounded-xl bg-[#25D366]/5 border border-[#25D366]/10 hover:bg-[#25D366]/10 transition-colors group">
                <div class="w-12 h-12 rounded-full bg-[#25D366] flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                </div>
                <div>
                  <p class="font-bold text-mps-dark">WhatsApp Principal</p>
                  <p class="text-gray-600">{contact.whatsappDisplay}</p>
                  <p class="text-xs text-gray-400 mt-1">Réponse rapide, 7j/7</p>
                </div>
              </a>

              <div class="flex items-start gap-4 p-4 rounded-xl bg-mps-navy/5 border border-mps-navy/10">
                <div class="w-12 h-12 rounded-full bg-mps-navy flex items-center justify-center text-white flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p class="font-bold text-mps-dark">Téléphone</p>
                  <p class="text-gray-600">{contact.phoneNumber || contact.whatsappDisplay}</p>
                  <p class="text-xs text-gray-400 mt-1">Appel et WhatsApp</p>
                </div>
              </div>

              <div class="flex items-start gap-4 p-4 rounded-xl bg-mps-navy/5 border border-mps-navy/10">
                <div class="w-12 h-12 rounded-full bg-mps-navy flex items-center justify-center text-white flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <p class="font-bold text-mps-dark">Horaires d'ouverture</p>
                  <p class="text-gray-600 whitespace-pre-line">{contact.hours}</p>
                </div>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-mps-cream border border-mps-gold/20">
            <h3 class="font-display text-lg font-bold text-mps-navy mb-2">Protection de vos informations</h3>
            <p class="text-sm text-gray-600">Les informations transmises servent à répondre à votre demande. Ne joignez aucun document sensible avant d’avoir reçu des consignes sécurisées.</p>
          </div>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-mps-navy mb-6">Envoyer une demande</h2>
          <form name="contact" method="POST" action="/merci" data-netlify="true" netlify-honeypot="bot-field" class="space-y-5">
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="subject" value="Nouvelle demande MEDP Services" />
            <p class="hidden">
              <label>Ne pas remplir : <input name="bot-field" /></label>
            </p>
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nom complet</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="Votre nom et prénom" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
                <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="+33 6 00 00 00 00" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all" placeholder="votre@email.com" />
              </div>
            </div>
            <div>
              <label for="service" class="block text-sm font-medium text-gray-700 mb-1">Service souhaité</label>
              <select id="service" name="service" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all bg-white">
                <option value="">Choisir un service...</option>
                {services.map(service => <option value={service.slug}>{service.data.title}</option>)}
                <option value="autre">Autre demande</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Votre message</label>
              <textarea id="message" name="message" rows="4" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-mps-navy focus:ring-2 focus:ring-mps-navy/20 outline-none transition-all resize-none" placeholder="Décrivez votre besoin en quelques lignes..."></textarea>
            </div>
            <label class="flex items-start gap-3 text-sm text-gray-600">
              <input type="checkbox" name="consent" value="oui" required class="mt-1 h-4 w-4 accent-mps-navy" />
              <span>J’accepte que mes informations soient utilisées pour répondre à ma demande. {privacyPage ? <a href="/confidentialite" class="text-mps-red underline">Consulter la politique de confidentialité</a> : 'Aucun document sensible ne doit être envoyé via ce formulaire.'}</span>
            </label>
            <button type="submit" class="w-full px-6 py-4 rounded-xl bg-mps-navy text-white font-bold text-lg hover:bg-blue-900 transition-all active:scale-95 shadow-lg flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Envoyer ma demande
            </button>
            <p class="text-xs text-gray-400 text-center">Vous recevrez une réponse sous 24h maximum.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="py-20 bg-mps-cream" aria-labelledby="faq-title">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-title" class="font-display text-3xl font-bold text-mps-navy mb-8 text-center">Questions fréquentes</h2>
        <div class="space-y-4">
          {faqs.map(item => (
            <details class="group bg-white rounded-2xl border border-gray-100 p-5">
              <summary class="cursor-pointer font-bold text-mps-navy marker:text-mps-gold">{item.data.question}</summary>
              <p class="mt-4 text-gray-600 leading-relaxed whitespace-pre-line">{item.data.answer}</p>
            </details>
          ))}
        </div>
      </div>
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org', '@type': 'FAQPage',
        mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.data.question, acceptedAnswer: { '@type': 'Answer', text: item.data.answer } }))
      }).replace(/</g, '\u003c')} />
    </section>
  )}
  <Footer />
  <WhatsAppButton />
</Layout>
